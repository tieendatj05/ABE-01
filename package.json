{
  "name": "medabe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "security:test": "vitest run security",
    "security:jar": "cd security/storage && mvnw -DskipTests package",
    "security:init": "tsx security/src/deploy/init.ts",
    "demo": "tsx security/src/deploy/demo.ts",
    "web:build": "vite build --config app/web/vite.config.ts",
    "parent": "node app/parent/run.mjs",
    "parent:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File launcher/make-parent-shortcut.ps1",
    "parent:firewall": "powershell -NoProfile -ExecutionPolicy Bypass -File launcher/open-firewall.ps1",
    "parent:pack": "node app/desktop/pack-parent.mjs",
    "parent:build": "vite build --config app/parent/vite.config.ts",
    "parent:dev": "vite --config app/parent/vite.config.ts",
    "parent:icons": "node app/parent/make-icons.mjs",
    "seed:phuhuynh": "tsx security/src/deploy/seed-phuhuynh.ts",
    "parent:shots": "tsx app/test-ui/parent-shots.ts",
    "mobile:build": "node app/mobile/build.mjs",
    "mobile:sync": "node app/mobile/build.mjs --sync",
    "mobile:android": "node app/mobile/build.mjs --sync && cd app/mobile && npx cap open android",
    "mobile:ios": "node app/mobile/build.mjs --sync && cd app/mobile && npx cap open ios",
    "public:tunnel": "node launcher/public-tunnel.mjs",
    "web:dev": "vite --config app/web/vite.config.ts",
    "desktop:build": "node app/desktop/build.mjs admin",
    "desktop": "npm run desktop:build && node app/desktop/run.mjs",
    "desktop:pack": "node app/desktop/build.mjs admin && node app/desktop/build-server.mjs && node app/desktop/pack.mjs admin",
    "desktop:build:user": "node app/desktop/build.mjs user",
    "desktop:pack:user": "node app/desktop/build.mjs user && node app/desktop/pack.mjs user",
    "launcher:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File launcher/make-shortcut.ps1",
    "admin:package": "tsx security/src/deploy/admin-package.ts",
    "demo:tancong": "tsx security/src/deploy/demo-tan-cong.ts",
    "demo:san-sang": "tsx app/test-ui/demo-kiem-tra-san-sang.ts",
    "demo:abe": "tsx app/test-ui/demo-chung-minh-abe.ts",
    "demo:anh-upenn": "tsx app/test-ui/anh-upenn-demo.ts --demo-tai",
    "demo:ten-ma-hoa": "tsx app/test-ui/ten-ma-hoa.ts",
    "research:tls": "tsx security/src/deploy/devtls.ts",
    "research:stack": "tsx security/src/deploy/research-stack.ts",
    "research:test": "vitest run security/src/research security/src/network",
    "research:test:java": "cd security/storage && mvnw -o test",
    "research:bench": "tsx security/src/research/bench.ts",
    "research:ui": "vite --config app/research/vite.config.ts",
    "research:ui:build": "vite build --config app/research/vite.config.ts",
    "research:server": "tsx security/src/deploy/research-server.ts",
    "research:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File launcher/make-research-shortcut.ps1",
    "desktop:pack:account": "node app/desktop/pack-account.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@vladmandic/human": "^3.3.6",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "puppeteer-core": "^25.13.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "main": "app/desktop/dist/main.cjs",
  "description": "MedABE - ung dung desktop ho so y te ma hoa bang CP-ABE"
}
