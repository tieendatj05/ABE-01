{
  "name": "ksk-phuhuynh-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Vỏ Capacitor đóng gói app phụ huynh (app/parent) thành ứng dụng Android và iPhone",
  "scripts": {
    "build": "node build.mjs",
